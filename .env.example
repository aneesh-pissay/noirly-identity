# =============================================================================
# Noirly Identity — environment variables
# =============================================================================
# Copy to .env.local and fill in values, or run: npm run env:generate
# Never commit real secrets.

NODE_ENV=development

# MongoDB connection string. Include the database name.
# Atlas URIs without a path default to the "test" database — use:
#   mongodb+srv://USER:PASS@cluster.mongodb.net/noirly-identity?appName=Cluster0
MONGODB_URI=mongodb://127.0.0.1:27017/noirly-identity

# Public base URL of this Identity service (no trailing slash)
APP_URL=http://localhost:3000

# OIDC issuer — usually the same as APP_URL in single-host deployments
OIDC_ISSUER=http://localhost:3000

# Random 32+ byte secrets (hex or base64). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-chars-of-random-data
ENCRYPTION_KEY=replace-with-at-least-32-chars-of-random-data

# RS256 signing keys (PKCS#8 private + SPKI public). Newlines may be escaped as \n.
# Generate with: npm run env:generate
# Or openssl:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_KEY_ID=noirly-identity-1

# Optional tuning
SESSION_COOKIE_NAME=noirly_session
CSRF_COOKIE_NAME=noirly_csrf
SESSION_TTL_SECONDS=1209600
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=60
EMAIL_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800
RESEND_VERIFICATION_COOLDOWN_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# development | smtp
EMAIL_PROVIDER=development
EMAIL_FROM="Noirly Identity <noreply@noirly.com>"

# Required when EMAIL_PROVIDER=smtp (Nodemailer)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Gmail example (use an App Password, not your normal password):
# EMAIL_PROVIDER=smtp
# EMAIL_FROM="Noirly Identity <you@gmail.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password

# Optional Google login (Identity-hosted). Create an OAuth client in Google Cloud:
# Authorized redirect URI must be exactly:
#   {APP_URL}/api/auth/google/callback
# Example: http://localhost:3000/api/auth/google/callback
#
# Authorized JavaScript origins (required for Google One Tap / GIS on Identity and products):
#   http://localhost:3000
#   http://localhost:3002
#   http://localhost:3003
#   http://localhost:3004
#   https://noirly.identity.aneesh-pissay.in
#   https://noirly.flow.aneesh-pissay.in
#   https://noirly.ledger.aneesh-pissay.in
#   https://noirly.pulse.aneesh-pissay.in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional comma-separated iOS/Android Google client IDs accepted as id_token audiences
# GOOGLE_MOBILE_CLIENT_IDS=

# -----------------------------------------------------------------------------
# Account deletion and privacy
# -----------------------------------------------------------------------------
# Apps told when someone deletes their account, as clientId=url pairs (comma or
# newline separated). Each gets a signed "account deleted" event (JWT, aud =
# clientId) and deletes its own data. Undelivered notices are retried with:
#   npm run account:retry-deletions
# ACCOUNT_DELETION_WEBHOOKS=noirly-flow=https://noirly.flow.aneesh-pissay.in/api/identity/account-deleted
#
# Address shown on /privacy and /delete-account for privacy requests.
# Defaults to the address in EMAIL_FROM.
# PRIVACY_CONTACT_EMAIL=
